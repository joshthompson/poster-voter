# ── .env.local ── used by `pnpm dev` (written automatically by `npx convex dev`)
# Your dev deployment, e.g. dev:happy-animal-123
CONVEX_DEPLOYMENT=
# Your dev deployment URL, e.g. https://happy-animal-123.convex.cloud
PUBLIC_CONVEX_URL=

# ── .env.production ── used by `pnpm deploy*`
# Convex dashboard → your project → Settings → Deploy keys → Generate production deploy key
CONVEX_DEPLOY_KEY=
# Sub-path the site is served from. Empty for the custom domain (postervote.com);
# /postervote for https://<user>.github.io/postervote.
BASE_PATH=
